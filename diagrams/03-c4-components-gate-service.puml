@startuml C4_Components_gate_service
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Components — gate-service (Управление воротами)

Container_Boundary(gateSvc, "gate-service") {
    Component(api, "Gate API", "REST Controllers", "Открыть / закрыть / статус ворот")
    Component(cmd, "Command Handler", "Application", "Сценарии управления воротами")
    Component(domain, "Gate Domain", "Domain Model", "Gate, GatePosition, LockState")
    Component(state, "Gate State Manager", "Repository", "Текущее положение и блокировка")
    Component(publisher, "Event Publisher", "Messaging", "GateCommandIssued")
    Component(consumer, "Event Consumer", "Messaging", "Ack / статус ворот")
}

ContainerDb(gateDb, "gate-db", "PostgreSQL", "Состояние ворот")
ContainerQueue(broker, "Message Broker", "Kafka / RabbitMQ", "Шина событий")
Container_Ext(gateway, "API Gateway", "Входной шлюз")

Rel(gateway, api, "REST-запросы", "HTTPS")
Rel(api, cmd, "Делегирует")
Rel(cmd, domain, "Использует модель")
Rel(cmd, state, "Читает/пишет")
Rel(state, gateDb, "SQL")
Rel(cmd, publisher, "Публикует команды")
Rel(publisher, broker, "Events")
Rel(broker, consumer, "Status events")
Rel(consumer, state, "Обновляет статус")

@enduml
