@startuml C4_Context_WarmHouse_AsIs
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Контекстная диаграмма (C4 Context) — As-Is: «Тёплый дом»

Person(user, "Пользователь", "Владелец дома. Управляет отоплением и просматривает температуру через веб-интерфейс.")

System(monolith, "Умный дом", "Монолитное приложение на Go. Обрабатывает HTTP-запросы, бизнес-логику управления датчиками/отоплением и работу с данными. Хранит состояние в PostgreSQL.")

System_Ext(heating, "Модули отопления", "Установленные в домах системы отопления с датчиками температуры и реле. Регистрируются при подключении специалистом; управление и опрос температуры идут синхронно от сервера к устройству.")

Rel(user, monolith, "Включает/выключает отопление, просматривает температуру", "HTTPS / Web UI")
Rel(monolith, heating, "Управляет датчиками и реле, запрашивает температуру", "Синхронный HTTP/API")
Rel(heating, monolith, "Регистрируются при подключении, отдают показания по запросу", "Синхронный ответ")

@enduml
