@startuml C4_Components_lighting_service
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Components — lighting-service (Управление освещением)

Container_Boundary(lightingSvc, "lighting-service") {
    Component(api, "Lighting API", "REST Controllers", "Вкл/выкл света, яркость, сцены")
    Component(cmd, "Command Handler", "Application", "Сценарии управления освещением")
    Component(domain, "Lighting Domain", "Domain Model", "LightDevice, Brightness, LightScene")
    Component(state, "Lighting State Manager", "Repository", "Текущее состояние света")
    Component(publisher, "Event Publisher", "Messaging", "LightingCommandIssued")
    Component(consumer, "Event Consumer", "Messaging", "Ack / статус устройств")
}

ContainerDb(lightingDb, "lighting-db", "PostgreSQL", "Состояние освещения")
ContainerQueue(broker, "Message Broker", "Kafka / RabbitMQ", "Шина событий")
Container_Ext(gateway, "API Gateway", "Входной шлюз")

Rel(gateway, api, "REST-запросы", "HTTPS")
Rel(api, cmd, "Делегирует")
Rel(cmd, domain, "Использует модель")
Rel(cmd, state, "Читает/пишет")
Rel(state, lightingDb, "SQL")
Rel(cmd, publisher, "Публикует команды")
Rel(publisher, broker, "Events")
Rel(broker, consumer, "Status events")
Rel(consumer, state, "Обновляет статус")

@enduml
